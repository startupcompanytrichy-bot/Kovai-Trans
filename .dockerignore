# =============================================================================
# Docker Ignore - Exclude files not needed in production
# =============================================================================

# Git
.git
.gitignore

# IDE
.idea
.vscode
*.swp
*.swo

# Node.js
node_modules
npm-debug.log*

# Laravel - exclude runtime files but keep directory structure (.gitkeep files)
storage/logs/*.log
storage/framework/cache/data/*
!storage/framework/cache/data/.gitkeep
storage/framework/sessions/*
!storage/framework/sessions/.gitkeep
storage/framework/views/*
!storage/framework/views/.gitkeep
bootstrap/cache/*.php

# Docker
docker-compose.yml
docker-compose.override.yml
.dockerignore

# Environment files
.env.local
.env.backup
.env.example

# Documentation
README.md
LICENSE

# Tests
tests
phpunit.xml
phpunit.xml.dist

# Development files
*.md
!README.md
database/database.sqlite
database/database.sqlite-journal

# Build artifacts
public/build/hot
public/build/manifest

# Misc
.DS_Store
Thumbs.db
*.cache
